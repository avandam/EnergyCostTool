<Window x:Class="EnergyCostTool.App.VariableCostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tariffs" Height="620" Width="1100" MinHeight="460" MinWidth="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Tariffs" FontSize="25" FontWeight="SemiBold" Foreground="#18324B"/>
            <TextBlock Text="Manage monthly variable energy prices" Foreground="#66788A" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Add" Click="Add_Click"/>
                <Button x:Name="EditButton" Content="Edit selected" IsEnabled="False" Click="Edit_Click"/>
                <Button x:Name="DeleteButton" Content="Delete selected" IsEnabled="False" Click="Delete_Click"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="VariableCostGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single" RowHeight="38" AlternatingRowBackground="#F6F9FC" GridLinesVisibility="Horizontal" BorderBrush="#DCE4EC" SelectionChanged="VariableCostGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Month" Binding="{Binding StartDate, StringFormat='{}{0:MMM yyyy}'}" Width="1.2*"/>
                    <DataGridTextColumn Header="Norm (€)" Binding="{Binding ElectricityHigh, StringFormat='{}{0}'}" Width="*"/>
                    <DataGridTextColumn Header="Dal (€)" Binding="{Binding ElectricityLow, StringFormat='{}{0}'}" Width="*"/>
                    <DataGridTextColumn Header="Norm T kosten (€)" Binding="{Binding ReturnElectricityHighCost, StringFormat='{}{0}'}" Width="1.3*"/>
                    <DataGridTextColumn Header="Norm T vergoeding (€)" Binding="{Binding ReturnElectricityHighCompensation, StringFormat='{}{0}'}" Width="1.5*"/>
                    <DataGridTextColumn Header="Dal T kosten (€)" Binding="{Binding ReturnElectricityLowCost, StringFormat='{}{0}'}" Width="1.3*"/>
                    <DataGridTextColumn Header="Dal T vergoeding (€)" Binding="{Binding ReturnElectricityLowCompensation, StringFormat='{}{0}'}" Width="1.5*"/>
                    <DataGridTextColumn Header="Gas (€)" Binding="{Binding Gas, StringFormat='{}{0}'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyLabel" Text="No variable tariffs have been entered yet." Foreground="#66788A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
