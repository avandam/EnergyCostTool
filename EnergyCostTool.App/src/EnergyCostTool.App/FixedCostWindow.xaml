<Window x:Class="EnergyCostTool.App.FixedCostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fixed costs" Height="620" Width="1000" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Fixed costs" FontSize="25" FontWeight="SemiBold" Foreground="#18324B"/>
                <TextBlock Text="Manage dated fixed-cost rates and tariff types" Foreground="#66788A" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Manage tariff types" Click="ManageTariffTypes_Click" Margin="12,0,0,0"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Order by" VerticalAlignment="Center" Foreground="#43566A" Margin="0,0,10,0"/>
            <ComboBox x:Name="SortOrderComboBox" Width="210" SelectedIndex="0" SelectionChanged="SortOrderComboBox_SelectionChanged">
                <ComboBoxItem Content="Start date (newest first)"/>
                <ComboBoxItem Content="Tariff type, then start date"/>
            </ComboBox>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Add" Click="Add_Click"/>
                <Button x:Name="EditButton" Content="Edit selected" IsEnabled="False" Click="Edit_Click"/>
                <Button x:Name="DeleteButton" Content="Delete selected" IsEnabled="False" Click="Delete_Click"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="FixedCostGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single" RowHeight="38" AlternatingRowBackground="#F6F9FC" GridLinesVisibility="Horizontal" BorderBrush="#DCE4EC" SelectionChanged="FixedCostGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Start date" Binding="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TariffTypeName}" Width="2*"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='{}{0} €'}" Width="*"/>
                    <DataGridTextColumn Header="Timeframe" Binding="{Binding Timeframe}" Width="*"/>
                    <DataGridTextColumn Header="Energy type" Binding="{Binding EnergyType}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyLabel" Text="No fixed costs have been entered yet." Foreground="#66788A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Grid.Row="3" Text="Add a tariff type before entering its fixed costs." Foreground="#66788A" Margin="0,12,0,0"/>
    </Grid>
</Window>
