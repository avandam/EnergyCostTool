<Window x:Class="EnergyCostTool.App.TariffTypeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tariff type" Height="360" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" VerticalAlignment="Center" Margin="0,6,12,6"/>
        <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,6,12,6"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" MaxLength="120" Margin="0,4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Timeframe" VerticalAlignment="Center" Margin="0,6,12,6"/>
        <ComboBox x:Name="TimeframeComboBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Energy type" VerticalAlignment="Center" Margin="0,6,12,6"/>
        <ComboBox x:Name="EnergyTypeComboBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84"/>
            <Button Content="Save" IsDefault="True" MinWidth="84" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
