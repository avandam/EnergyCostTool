<Window x:Class="EnergyCostTool.App.TariffTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fixed-cost tariff types" Height="520" Width="900" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Fixed-cost tariff types" FontSize="23" FontWeight="SemiBold" Foreground="#18324B"/>
                <TextBlock Text="Types are shared by fixed-cost entries" Foreground="#66788A" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add" Click="Add_Click"/>
                <Button Content="Edit selected" Click="Edit_Click"/>
                <Button Content="Delete selected" Click="Delete_Click"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="TypesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" RowHeight="38" AlternatingRowBackground="#F6F9FC" GridLinesVisibility="Horizontal" BorderBrush="#DCE4EC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Timeframe" Binding="{Binding Timeframe}" Width="*"/>
                <DataGridTextColumn Header="Energy type" Binding="{Binding EnergyType}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="Tariff types referenced by a fixed-cost entry cannot be deleted." Foreground="#66788A" Margin="0,12,0,0"/>
    </Grid>
</Window>
